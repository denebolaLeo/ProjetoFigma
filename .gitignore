# ========================================================
# .gitignore — Hélio Medeiros Portfólio
# Regras recomendadas para projetos web modernos
# ========================================================

# --- Sistema Operacional ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- Editores & IDEs ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, PhpStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim / Emacs
*.swp
*.swo
*.swn
*~
.#*

# --- Variáveis de Ambiente & Credenciais (Segurança) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --- Gerenciadores de Pacotes & Dependências (Node.js) ---
# Caso adicione build tools como Vite, Sass, Tailwind, etc.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Pastas de Build e Saída ---
dist/
build/
out/
.cache/
.parcel-cache/

# --- Arquivos Temporários de Servidores / Python ---
# Caso use python3 -m http.server
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Logs & Testes ---
logs/
*.log
coverage/
.nyc_output/

# --- Arquivos Temporários de Sistema / Agentes ---
.temp/
tmp/
*.tmp

